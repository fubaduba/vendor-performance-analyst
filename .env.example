# Foundry project endpoint (from the Foundry portal)
AZURE_AI_PROJECT_ENDPOINT= https://luechen-swedencentral-foundry.services.ai.azure.com/api/projects/luechen-sc-fdp-1

# Model deployment (for the agent itself, not the judge)
MODEL_DEPLOYMENT_NAME=gpt-4o

# --- FAOS-optimizable knobs ---
# Either SYSTEM_PROMPT_TEXT (full text, set by FAOS during optimization runs)
# or SYSTEM_PROMPT_PATH (path to a prompt file, used in dev).
# Default: agent/prompts/system_prompt_v1.md
# SYSTEM_PROMPT_TEXT="..."
# SYSTEM_PROMPT_PATH=agent/prompts/system_prompt_v1.md

AGENT_VERSION=v1

# --- For local_run.py only (skip if running through Foundry) ---
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
